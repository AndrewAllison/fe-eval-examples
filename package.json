{
  "name": "fe-eval-examples",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "ai-sdlc:audit": "frontend-sdlc-audit --repo . --out .artifacts/ai-sdlc-audit",
    "ai-sdlc:audit:strict": "frontend-sdlc-audit --repo . --out .artifacts/ai-sdlc-audit --fail-on red",
    "build": "next build",
    "db:check": "drizzle-kit check",
    "db:down": "POSTGRES_PORT=5432 docker compose down",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:up": "POSTGRES_PORT=5432 docker compose up -d --wait database",
    "db:studio": "drizzle-kit studio",
    "dev": "next dev --experimental-https",
    "dev:http": "next dev",
    "env:setup": "node scripts/setup-env.ts",
    "evidence:capture": "node scripts/capture-evidence.ts",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "guardrails": "depcruise src --config dependency-cruiser.config.mjs",
    "lint": "oxlint --type-aware --type-check --deny-warnings --report-unused-disable-directives",
    "security": "pnpm security:dependencies && pnpm security:secrets",
    "security:dependencies": "pnpm audit --audit-level moderate",
    "security:secrets": "docker compose -f compose.tools.yml run --rm gitleaks git --no-banner --no-color --redact /repo && docker compose -f compose.tools.yml run --rm gitleaks dir --no-banner --no-color --redact /repo",
    "static": "knip",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "next typegen && tsc --noEmit",
    "verify": "pnpm ai-sdlc:audit && pnpm workflow:lint && pnpm security && pnpm format:check && pnpm lint && pnpm typecheck && pnpm guardrails && pnpm static && pnpm test && pnpm db:check && pnpm build",
    "workflow:lint": "docker compose -f compose.tools.yml run --rm actionlint && docker compose -f compose.tools.yml run --rm zizmor",
    "worktree:create": "node scripts/create-worktree.ts",
    "worktree:dev": "node scripts/worktree-runtime.ts dev",
    "worktree:down": "node scripts/worktree-runtime.ts down",
    "start": "next start"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@better-auth/drizzle-adapter": "^1.6.26",
    "better-auth": "^1.6.26",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "lucide-react": "^1.31.0",
    "next": "16.3.0",
    "pg": "^8.23.0",
    "pino": "^10.3.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@next/env": "^16.3.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^7.0.1",
    "@types/node": "^24.13.3",
    "@types/pg": "^8.21.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.0.5",
    "@vitest/coverage-v8": "^4.1.10",
    "agent-browser": "0.34.0",
    "dependency-cruiser": "^18.2.0",
    "drizzle-kit": "^0.31.10",
    "frontend-sdlc-audit": "github:AndrewAllison/frontend-sdlc-audit#45722f3001c1f8ed9c7893cccae994cb36e09f77",
    "jsdom": "^30.0.1",
    "knip": "^6.32.1",
    "oxfmt": "^0.63.0",
    "oxlint": "^1.78.0",
    "oxlint-tsgolint": "^7.0.2001",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=24 <27"
  },
  "packageManager": "pnpm@11.21.0+sha512.521705bce689924eac72f5a3587122f362689ef6571e55ba80076fd637c11132ecffada26fad4ea79c485bfddbfd3d5a2a5b05805a77e893de71ec8a6cca3bb1"
}
